# Copy to .env.local at the repo root (git-ignored) and fill in. Never commit real values.
# The web app (web/) and the spikes (spikes/) both read this one file.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be SANDBOX; the app refuses to start otherwise.
PAYPAL_ENVIRONMENT=SANDBOX
# Sandbox personal account that receives payouts (spikes only).
PAYPAL_FREELANCER_EMAIL=
# Id of the registered webhook; written by `npx tsx 03-webhook/register-webhook.ts` in spikes/.
PAYPAL_WEBHOOK_ID=

# Google Gemini API key (free tier; prompts may be used by Google, so only public/seeded text is sent).
GEMINI_API_KEY=

# Neon Postgres, pooled connection string (host contains "-pooler"). Migrations derive the direct host.
DATABASE_URL=

# Fine-grained GitHub token for antonyjasfer/arbiter-runner only (Actions read/write, Contents read).
GITHUB_RUNNER_TOKEN=
# owner/name of the runner repo, e.g. antonyjasfer/arbiter-runner
RUNNER_REPO=
# Fixture repo used by the runner spike.
FIXTURE_REPO_URL=

# Auth.js. Generate a secret with `npx auth secret` or 32 random bytes, base64url.
AUTH_SECRET=
# GitHub OAuth app "Arbiter (local)": callback http://localhost:3000/api/auth/callback/github
# (The live app "Arbiter", callback https://arbiter-q41f.onrender.com/api/auth/callback/github,
#  has its own id and secret, set only in the Render dashboard.)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
